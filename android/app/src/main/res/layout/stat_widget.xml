<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:clipToOutline="true" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/widget_surface_dark">
    <TextView android:id="@+id/stat_widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/widget_net_worth"
        android:textColor="#FFB8C0CC" android:textSize="12sp" android:includeFontPadding="false"
        android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/stat_widget_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFB8C0CC"
            android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/stat_widget_value" android:layout_width="match_parent"
            android:layout_height="34dp" android:layout_marginTop="4dp" android:text="0"
            android:textColor="#FFF5F5F7" android:textSize="28sp" android:textStyle="bold"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp"
            android:maxLines="1" android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/stat_widget_bottom" android:layout_width="match_parent"
        android:layout_height="64dp" android:visibility="gone">
        <TextView android:id="@+id/stat_widget_secondary" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:visibility="gone"/>
        <ImageView android:id="@+id/stat_widget_ring" android:layout_width="64dp"
            android:layout_height="64dp" android:layout_gravity="end|bottom"
            android:scaleType="fitCenter" android:visibility="gone"
            android:contentDescription="@string/widget_budget_ring_content_description"/>
    </FrameLayout>
    <ImageView android:id="@+id/stat_widget_chart" android:layout_width="match_parent"
        android:layout_height="44dp" android:scaleType="fitXY" android:visibility="gone"
        android:contentDescription="@string/widget_chart_content_description"/>
</LinearLayout>
